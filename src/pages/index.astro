---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Gillie AI - Tu Asistente Inteligente" description="Gillie AI es un asistente inteligente que te ayuda con tareas diarias, procesamiento de documentos, y mucho más.">

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="relative pt-14 pb-16 md:pt-16 md:pb-20 overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-blue-100/60 to-transparent rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-cyan-100/40 to-transparent rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <!-- Text -->
        <div class="reveal text-center lg:text-left">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-900 mb-5 md:mb-6 leading-tight tracking-tight">
            Tu Asistente
            <span class="gradient-text"> Inteligente</span>
            <br/>Personal
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-gray-500 mb-7 md:mb-10 leading-relaxed max-w-lg mx-auto lg:mx-0">
            Gillie AI es más que un chatbot. Procesa documentos, automatiza tareas y se integra con tus herramientas favoritas.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 md:gap-4 mb-7 md:mb-12 justify-center lg:justify-start">
            <a href="#contact" class="btn-primary justify-center">
              <Icon name="lucide:rocket" class="w-5 h-5" />
              Comenzar Gratis
            </a>
            <a href="#features" class="btn-secondary justify-center">
              <Icon name="lucide:play-circle" class="w-5 h-5" />
              Ver Características
            </a>
          </div>

          <!-- Stats row -->
          <div class="flex flex-wrap items-center gap-4 md:gap-8 text-sm text-gray-500 justify-center lg:justify-start">
            <div class="flex items-center gap-2">
              <Icon name="lucide:shield-check" class="w-4 h-4 text-green-500" />
              Sin tarjeta de crédito
            </div>
            <div class="flex items-center gap-2">
              <Icon name="lucide:zap" class="w-4 h-4 text-yellow-500" />
              Setup en minutos
            </div>
          </div>
        </div>

        <!-- Illustration -->
        <div class="relative reveal reveal-delay-2 flex items-center justify-center hidden sm:flex">
          <div class="relative z-10 animate-float w-full">
            <img
              src={`${import.meta.env.BASE_URL}assets/abyssal-fish.png`}
              alt="Gillie AI — pez abisal bioluminiscente"
              class="w-full max-w-xs sm:max-w-lg md:max-w-2xl mx-auto drop-shadow-2xl scale-110"
            />
          </div>
          <!-- Glow blobs -->
          <div class="absolute -top-8 -right-8 w-96 h-96 bg-blue-400/15 rounded-full blur-3xl -z-10"></div>
          <div class="absolute -bottom-8 -left-8 w-96 h-96 bg-cyan-400/15 rounded-full blur-3xl -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── LOGOS / TRUST BAR ─────────────────────────────────────────────── -->
  <section class="py-10 border-y border-gray-100 bg-white/60">
    <div class="container mx-auto px-6">
      <p class="text-center text-sm text-gray-400 mb-8 uppercase tracking-widest font-medium">Compatible con las herramientas que ya usás</p>
      <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-4 opacity-55">
        {[
          { icon: 'lucide:bot',           label: 'OpenAI' },
          { icon: 'lucide:cpu',           label: 'Anthropic' },
          { icon: 'lucide:zap',           label: 'DeepSeek' },
          { icon: 'lucide:message-circle',label: 'WhatsApp' },
          { icon: 'lucide:send',          label: 'Telegram' },
          { icon: 'lucide:hash',          label: 'Slack' },
          { icon: 'lucide:calendar',      label: 'Google Calendar' },
          { icon: 'lucide:hard-drive',    label: 'Google Drive' },
          { icon: 'lucide:database',      label: 'SQL DB' },
          { icon: 'lucide:shopping-bag',  label: 'MercadoLibre' },
          { icon: 'lucide:file-text',     label: 'PDF / OCR' },
          { icon: 'lucide:cloud',         label: 'AWS S3' },
        ].map(item => (
          <div class="flex items-center gap-2 text-gray-600 font-semibold text-sm">
            <Icon name={item.icon} class="w-4 h-4" /> {item.label}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DEPLOYMENT MODES ─────────────────────────────────────────────── -->
  <section class="py-12 md:py-20">
    <div class="container mx-auto px-6">

      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 text-gillie-blue text-sm font-semibold uppercase tracking-widest mb-4">
          <Icon name="lucide:monitor-smartphone" class="w-4 h-4" />
          Dónde corre
        </span>
        <h2 class="section-title">Tu asistente, en cualquier entorno</h2>
        <p class="section-subtitle">
          Usalo desde tu computadora para el día a día o desplegalo en un servidor para automatizar tus sistemas 24/7
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">

        <!-- PC / Local -->
        <div class="reveal reveal-delay-1 group relative bg-white rounded-2xl border border-gray-100 p-8 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 overflow-hidden">
          <div class="absolute -bottom-8 -right-8 w-40 h-40 bg-blue-50 rounded-full blur-2xl pointer-events-none"></div>

          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-50 mb-6">
            <Icon name="lucide:laptop" class="w-6 h-6 text-blue-500" />
          </div>

          <h3 class="text-xl font-bold text-gray-900 mb-2">En tu PC</h3>
          <p class="text-gray-500 text-sm leading-relaxed mb-6">
            Asistente personal en tu terminal o interfaz web. Te ayuda a leer archivos, buscar información, escribir código y gestionar tareas del día a día sin salir de tu flujo de trabajo.
          </p>

          <ul class="space-y-2.5">
            {[
              { icon: 'lucide:terminal',    text: 'CLI interactivo con historial y modos (plan/auto/yolo)' },
              { icon: 'lucide:file-search', text: 'Lee, edita y crea archivos locales' },
              { icon: 'lucide:git-branch',  text: 'Git nativo: status, diff, log, commit' },
              { icon: 'lucide:globe',       text: 'Automatiza el navegador (Chromium)' },
              { icon: 'lucide:database',    text: 'Consulta bases de datos SQL locales' },
              { icon: 'lucide:mic',         text: 'Dictado por voz (STT) y respuestas habladas (TTS)' },
            ].map(item => (
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <div class="flex-shrink-0 w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center">
                  <Icon name={item.icon} class="w-3.5 h-3.5 text-blue-500" />
                </div>
                {item.text}
              </li>
            ))}
          </ul>
        </div>

        <!-- VPS / Server -->
        <div class="reveal reveal-delay-2 group relative bg-gray-950 rounded-2xl border border-gray-800 p-8 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 overflow-hidden">
          <div class="absolute -bottom-8 -right-8 w-40 h-40 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>

          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-cyan-500/15 mb-6">
            <Icon name="lucide:server" class="w-6 h-6 text-cyan-400" />
          </div>

          <h3 class="text-xl font-bold text-white mb-2">En tu VPS</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-6">
            Desplegalo en tu servidor para que trabaje de forma autónoma. Recibe mensajes por WhatsApp o Telegram, ejecuta tareas programadas y automatiza tus sistemas sin intervención manual.
          </p>

          <ul class="space-y-2.5">
            {[
              { icon: 'lucide:message-circle', text: 'Atiende WhatsApp, Telegram y Slack' },
              { icon: 'lucide:clock',          text: 'Scheduler con cron: tareas 24/7' },
              { icon: 'lucide:calendar',       text: 'Sincroniza Google Calendar y Drive' },
              { icon: 'lucide:database',       text: 'Consulta y opera bases de datos SQL' },
              { icon: 'lucide:webhook',        text: 'Webhooks entrantes y API REST' },
              { icon: 'lucide:shopping-bag',   text: 'Automatiza MercadoLibre' },
            ].map(item => (
              <li class="flex items-center gap-3 text-sm text-gray-300">
                <div class="flex-shrink-0 w-7 h-7 rounded-lg bg-white/8 flex items-center justify-center">
                  <Icon name={item.icon} class="w-3.5 h-3.5 text-cyan-400" />
                </div>
                {item.text}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ── FEATURES ─────────────────────────────────────────────────────── -->
  <section
    id="features"
    class="py-14 md:py-24 relative overflow-hidden"
    style="background-image: url('/assets/gillie-ocean.png'); background-size: cover; background-position: center 40%;"
  >
    <div class="absolute inset-0 bg-white/90 backdrop-blur-sm"></div>

    <div class="relative z-10 container mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <span class="inline-flex items-center gap-2 text-gillie-blue text-sm font-semibold uppercase tracking-widest mb-4">
          <Icon name="lucide:layers" class="w-4 h-4" />
          Capacidades
        </span>
        <h2 class="section-title">Características Principales</h2>
        <p class="section-subtitle">
          Descubre todo lo que Gillie AI puede hacer por ti
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="reveal reveal-delay-1">
          <FeatureCard
            icon="lucide:brain"
            title="Documentos con IA"
            description="Lee, analiza y extrae datos de PDFs, Word, Excel e imágenes con OCR. También escribe y edita archivos directamente."
            gradient="from-violet-500 to-purple-600"
          />
        </div>
        <div class="reveal reveal-delay-2">
          <FeatureCard
            icon="lucide:search"
            title="RAG sobre tus datos"
            description="Indexa tus propios documentos y obtén respuestas precisas basadas en tu conocimiento. Búsqueda vectorial con FAISS y Qdrant."
            gradient="from-blue-500 to-cyan-500"
          />
        </div>
        <div class="reveal reveal-delay-3">
          <FeatureCard
            icon="lucide:memory-stick"
            title="Memoria Persistente"
            description="El asistente recuerda información entre sesiones: preferencias, soluciones previas y contexto acumulado de tu trabajo."
            gradient="from-cyan-500 to-teal-500"
          />
        </div>
        <div class="reveal reveal-delay-4">
          <FeatureCard
            icon="lucide:clock"
            title="Tareas Programadas"
            description="Crea y gestiona tareas automáticas con cron. El asistente ejecuta workflows sin intervención manual en los horarios que definas."
            gradient="from-green-500 to-emerald-500"
          />
        </div>
        <div class="reveal reveal-delay-5">
          <FeatureCard
            icon="lucide:globe"
            title="Navegación Web Autónoma"
            description="Controla el navegador de forma autónoma: navega, hace click, extrae contenido y toma screenshots de cualquier web."
            gradient="from-orange-500 to-amber-500"
          />
        </div>
        <div class="reveal reveal-delay-6">
          <FeatureCard
            icon="lucide:git-branch"
            title="Flujo de Desarrollo"
            description="Lee repos, ejecuta git status, diff, log y commits. Ejecuta comandos shell y analiza tu código directamente desde el chat."
            gradient="from-pink-500 to-rose-500"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────────────── -->
  <section id="how-it-works" class="py-14 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <span class="inline-flex items-center gap-2 text-gillie-blue text-sm font-semibold uppercase tracking-widest mb-4">
          <Icon name="lucide:map" class="w-4 h-4" />
          Proceso
        </span>
        <h2 class="section-title">Cómo Funciona</h2>
        <p class="section-subtitle">
          De cero a tu asistente corriendo en minutos
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
        <!-- Connecting line (desktop) — spans from center of card 1 to center of card 3 -->
        <div class="hidden md:block absolute top-8 left-[calc(33%+2rem)] right-[calc(33%+2rem)] h-px bg-gradient-to-r from-blue-300 via-cyan-400 to-teal-300"></div>

        <!-- Step 1 -->
        <div class="bg-white rounded-2xl border border-gray-100 p-7 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 reveal reveal-delay-1">
          <div class="flex items-center gap-4 mb-5">
            <div class="flex-shrink-0 inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-200">
              <Icon name="lucide:package" class="w-7 h-7" />
            </div>
            <div>
              <div class="text-xs font-bold text-blue-400 uppercase tracking-widest">Paso 01</div>
              <h3 class="text-lg font-bold text-gray-900">Instalación</h3>
            </div>
          </div>
          <p class="text-gray-500 text-sm leading-relaxed mb-5">
            Levantá el servidor con Docker en un solo comando. También podés instalarlo localmente con pip para usar el CLI.
          </p>
          <!-- Quick start snippet -->
          <div class="bg-gray-950 rounded-xl px-4 py-3 font-mono text-xs text-gray-300 space-y-1">
            <div><span class="text-gray-500"># Docker (servidor)</span></div>
            <div><span class="text-cyan-400">make</span> build <span class="text-gray-500">&amp;&amp;</span> <span class="text-cyan-400">make</span> run</div>
            <div class="pt-1"><span class="text-gray-500"># o CLI local</span></div>
            <div><span class="text-cyan-400">pip</span> install gillie-ai</div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="bg-white rounded-2xl border border-gray-100 p-7 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 reveal reveal-delay-2">
          <div class="flex items-center gap-4 mb-5">
            <div class="flex-shrink-0 inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-500 text-white shadow-lg shadow-cyan-200">
              <Icon name="lucide:settings-2" class="w-7 h-7" />
            </div>
            <div>
              <div class="text-xs font-bold text-cyan-400 uppercase tracking-widest">Paso 02</div>
              <h3 class="text-lg font-bold text-gray-900">Configuración</h3>
            </div>
          </div>
          <p class="text-gray-500 text-sm leading-relaxed mb-5">
            Definí tu proveedor LLM y activá las integraciones que necesitás desde el panel o el archivo <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs text-gray-700">.env</code>.
          </p>
          <ul class="space-y-2">
            {[
              { icon: 'lucide:key',           text: 'API key de OpenAI, Anthropic o DeepSeek' },
              { icon: 'lucide:message-circle', text: 'Conecta WhatsApp, Telegram o Slack' },
              { icon: 'lucide:database',       text: 'Agrega bases de datos SQL o documentos RAG' },
              { icon: 'lucide:clock',          text: 'Configura tareas cron automáticas' },
            ].map(item => (
              <li class="flex items-center gap-2.5 text-sm text-gray-600">
                <Icon name={item.icon} class="w-3.5 h-3.5 text-cyan-500 flex-shrink-0" />
                {item.text}
              </li>
            ))}
          </ul>
        </div>

        <!-- Step 3 -->
        <div class="bg-white rounded-2xl border border-gray-100 p-7 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 reveal reveal-delay-3">
          <div class="flex items-center gap-4 mb-5">
            <div class="flex-shrink-0 inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-teal-500 to-cyan-400 text-white shadow-lg shadow-teal-200">
              <Icon name="lucide:play" class="w-7 h-7" />
            </div>
            <div>
              <div class="text-xs font-bold text-teal-400 uppercase tracking-widest">Paso 03</div>
              <h3 class="text-lg font-bold text-gray-900">A trabajar</h3>
            </div>
          </div>
          <p class="text-gray-500 text-sm leading-relaxed mb-5">
            Interactuá desde el canal que prefieras. El asistente recuerda contexto, ejecuta herramientas y aprende de tu flujo.
          </p>
          <div class="grid grid-cols-2 gap-2">
            {[
              { icon: 'lucide:terminal',       label: 'CLI' },
              { icon: 'lucide:globe',          label: 'Web UI' },
              { icon: 'lucide:message-circle', label: 'WhatsApp' },
              { icon: 'lucide:send',           label: 'Telegram' },
              { icon: 'lucide:hash',           label: 'Slack' },
              { icon: 'lucide:code-2',         label: 'REST API' },
            ].map(item => (
              <div class="flex items-center gap-2 bg-gray-50 rounded-lg px-3 py-2 text-xs font-medium text-gray-600">
                <Icon name={item.icon} class="w-3.5 h-3.5 text-teal-500" />
                {item.label}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── USE CASES ─────────────────────────────────────────────────────── -->
  <section id="use-cases" class="py-24">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <span class="inline-flex items-center gap-2 text-gillie-blue text-sm font-semibold uppercase tracking-widest mb-4">
          <Icon name="lucide:briefcase" class="w-4 h-4" />
          Aplicaciones
        </span>
        <h2 class="section-title">Casos de Uso</h2>
        <p class="section-subtitle">
          Gillie AI se adapta a diferentes necesidades y sectores
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <UseCaseCard
          title="Educación"
          description="Asistente para estudiantes y profesores, procesamiento de material educativo, tutoría personalizada."
          features={["Procesa PDFs académicos", "Responde preguntas específicas", "Genera resúmenes"]}
          color="blue"
        />
        <UseCaseCard
          title="Negocios"
          description="Automatización de procesos, análisis de documentos comerciales, atención al cliente inteligente."
          features={["Procesa contratos", "Analiza reportes", "Integración WhatsApp"]}
          color="green"
        />
        <UseCaseCard
          title="Desarrollo"
          description="API para desarrolladores, integración con aplicaciones existentes, automatización de workflows."
          features={["API RESTful", "Webhooks", "SDKs disponibles"]}
          color="purple"
        />
        <UseCaseCard
          title="Personal"
          description="Organización personal, recordatorios inteligentes, procesamiento de documentos personales."
          features={["Gestión de tareas", "Recordatorios", "Procesamiento OCR"]}
          color="orange"
        />
      </div>
    </div>
  </section>

  <!-- ── API SECTION ───────────────────────────────────────────────────── -->
  <section id="api" class="py-14 md:py-24 bg-gray-950 text-white relative overflow-hidden">
    <!-- Decorative glow -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl"></div>

    <div class="relative z-10 container mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <span class="inline-flex items-center gap-2 text-cyan-400 text-sm font-semibold uppercase tracking-widest mb-4">
          <Icon name="lucide:terminal" class="w-4 h-4" />
          Desarrolladores
        </span>
        <h2 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">API Poderosa</h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">
          Integra Gillie AI en tus aplicaciones con nuestra API completa y documentada
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Features list -->
        <div class="reveal reveal-delay-1 space-y-4">
          {[
            { icon: 'lucide:book-open',   label: 'Documentación OpenAPI / Swagger' },
            { icon: 'lucide:shield',      label: 'Autenticación JWT segura' },
            { icon: 'lucide:webhook',     label: 'Webhooks para eventos en tiempo real' },
            { icon: 'lucide:layers',      label: 'SDKs para múltiples lenguajes' },
          ].map(item => (
            <div class="flex items-center gap-4 bg-white/5 border border-white/8 rounded-xl px-5 py-4 hover:bg-white/8 transition-colors">
              <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-cyan-500/15 flex items-center justify-center">
                <Icon name={item.icon} class="w-5 h-5 text-cyan-400" />
              </div>
              <span class="text-gray-200 font-medium">{item.label}</span>
            </div>
          ))}

          <div class="pt-2">
            <a href="#" class="btn-primary bg-gradient-to-r from-gillie-blue to-cyan-500 border-0">
              <Icon name="lucide:external-link" class="w-5 h-5" />
              Ver Documentación API
            </a>
          </div>
        </div>

        <!-- Code block -->
        <div class="reveal reveal-delay-2 bg-gray-900 rounded-2xl overflow-hidden border border-white/8 shadow-2xl">
          <!-- Window chrome -->
          <div class="flex items-center gap-2 px-5 py-3 border-b border-white/8 bg-gray-800/60">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="ml-3 text-gray-500 text-xs font-mono">api.gillie.ai · example.js</span>
          </div>
          <pre class="text-sm text-gray-300 p-6 overflow-x-auto leading-relaxed font-mono">{`// Ejemplo de uso de la API
const response = await fetch(
  'https://api.gillie.ai/v1/chat',
  {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer YOUR_API_KEY',
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      message: 'Procesa este documento PDF',
      document_url: 'https://example.com/doc.pdf',
      context: 'educación'
    })
  }
);

const { response: reply } = await response.json();
console.log(reply);`}</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INTEGRATIONS ─────────────────────────────────────────────────── -->
  <section id="integrations" class="py-14 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6">

      <div class="text-center mb-16 reveal">
        <span class="inline-flex items-center gap-2 text-gillie-blue text-sm font-semibold uppercase tracking-widest mb-4">
          <Icon name="lucide:plug" class="w-4 h-4" />
          Integraciones
        </span>
