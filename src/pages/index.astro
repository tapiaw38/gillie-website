---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Gillie AI - Your Intelligent Assistant" description="Gillie AI is an intelligent assistant that helps you with daily tasks, document processing, and much more.">

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="relative pt-4 pb-16 md:pt-6 md:pb-20 overflow-hidden bg-black">

    <div class="container mx-auto px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Text -->
        <div class="reveal text-center lg:text-left">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-5 md:mb-6 leading-tight tracking-tight">
            Your Personal
            <span class="gradient-text"> Intelligent</span>
            <br/>Assistant
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-white/60 mb-7 md:mb-10 leading-relaxed max-w-lg mx-auto lg:mx-0">
            Gillie AI is more than a chatbot. It processes documents, automates tasks, and integrates with your favorite tools.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-8 md:mb-14 justify-center lg:justify-start">
            <a href="#contact" class="btn-primary justify-center text-base px-8 py-4 shadow-[0_4px_20px_0_rgba(30,100,220,0.5)] hover:shadow-[0_6px_28px_0_rgba(30,100,220,0.6)] hover:scale-[1.02]">
              <Icon name="lucide:rocket" class="w-5 h-5" />
              Get Started Free
            </a>
            <a href="#features" class="btn-secondary justify-center text-base px-8 py-4 hover:scale-[1.02]">
              <Icon name="lucide:play-circle" class="w-5 h-5" />
              See Features
            </a>
          </div>

          <!-- Stats row (pill style) -->
          <div class="flex flex-wrap items-center gap-3 text-xs justify-center lg:justify-start">
            <span class="rounded-full border border-white/[0.08] bg-white/[0.03] px-4 py-1.5 text-white/60">No credit card</span>
            <span class="rounded-full border border-white/[0.08] bg-white/[0.03] px-4 py-1.5 text-white/60">Setup in minutes</span>
            <span class="rounded-full border border-white/[0.08] bg-white/[0.03] px-4 py-1.5 text-white/60">Docker ready</span>
          </div>
        </div>

        <!-- Illustration -->
        <div class="relative reveal reveal-delay-2 flex items-center justify-center hidden sm:flex">
          <div class="relative z-10 animate-float w-full">
            <img
              src={`${import.meta.env.BASE_URL}assets/abyssal-fish.png`}
              alt="Gillie AI — bioluminescent abyssal fish"
              class="w-full max-w-xs sm:max-w-lg md:max-w-2xl mx-auto"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST BAR ─────────────────────────────────────────────────────── -->
  <section class="border-y border-white/[0.06] bg-black/30 py-6">
    <div class="container mx-auto px-6 max-w-6xl">
      <p class="mb-5 text-center text-xs uppercase tracking-[0.2em] text-white/40">
        Works with your existing stack
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {['OpenAI', 'Anthropic', 'DeepSeek', 'Ollama', 'WhatsApp', 'Telegram', 'Slack', 'Google Calendar', 'SQL DB', 'PDF / OCR'].map(item => (
          <span class="rounded-full border border-white/[0.08] bg-white/[0.02] px-4 py-1.5 text-xs text-white/60">
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DEPLOYMENT MODES ─────────────────────────────────────────────── -->
  <section class="py-12 md:py-20">
    <div class="container mx-auto px-6 max-w-6xl">

      <div class="text-center mb-12 reveal">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-gillie-blue">Where It Runs</p>
        <h2 class="section-title">Your assistant, in any environment</h2>
        <p class="section-subtitle">
          Use it from your computer for daily tasks or deploy it on a server to automate your systems 24/7
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- PC / Local -->
        <div class="reveal reveal-delay-1 group relative bg-white/[0.03] rounded-lg border border-white/10 p-8 hover:bg-white/[0.05] hover:-translate-y-1 hover:border-blue-500/30 transition-all duration-300 overflow-hidden">
          <div class="absolute -bottom-8 -right-8 w-40 h-40 bg-blue-500/5 group-hover:bg-blue-500/10 rounded-full blur-2xl pointer-events-none transition-all duration-300"></div>

          <div class="mb-6">
            <Icon name="lucide:laptop" class="w-7 h-7 text-blue-400" />
          </div>

          <h3 class="text-xl font-bold text-white mb-3">On Your PC</h3>
          <p class="text-white/70 text-sm leading-relaxed mb-6">
            Personal assistant in your terminal or web interface. Helps you read files, search information, write code, and manage daily tasks without leaving your workflow.
          </p>

          <ul class="space-y-2.5">
            {[
              { icon: 'lucide:terminal',    text: 'Interactive CLI with history and modes (plan/auto/yolo)' },
              { icon: 'lucide:file-search', text: 'Read, edit, and create local files' },
              { icon: 'lucide:git-branch',  text: 'Native Git: status, diff, log, commit' },
              { icon: 'lucide:globe',       text: 'Automate browser (Chromium)' },
              { icon: 'lucide:database',    text: 'Query local SQL databases' },
              { icon: 'lucide:mic',         text: 'Voice dictation (STT) and spoken responses (TTS)' },
            ].map(item => (
              <li class="flex items-center gap-3 text-sm text-white/60">
                <div class="flex-shrink-0 w-7 h-7 rounded bg-blue-500/10 flex items-center justify-center">
                  <Icon name={item.icon} class="w-3.5 h-3.5 text-blue-400" />
                </div>
                {item.text}
              </li>
            ))}
          </ul>
        </div>

        <!-- VPS / Server -->
        <div class="reveal reveal-delay-2 group relative bg-white/[0.03] rounded-lg border border-white/10 p-8 hover:bg-white/[0.05] hover:-translate-y-1 hover:border-cyan-500/30 transition-all duration-300 overflow-hidden">
          <div class="absolute -bottom-8 -right-8 w-40 h-40 bg-cyan-500/10 group-hover:bg-cyan-500/15 rounded-full blur-2xl pointer-events-none transition-all duration-300"></div>

          <div class="mb-6">
            <Icon name="lucide:server" class="w-7 h-7 text-cyan-400" />
          </div>

          <h3 class="text-xl font-bold text-white mb-3">On Your VPS</h3>
          <p class="text-white/70 text-sm leading-relaxed mb-6">
            Deploy it on your server to work autonomously. Receive messages via WhatsApp or Telegram, run scheduled tasks, and automate your systems without manual intervention.
          </p>

          <ul class="space-y-2.5">
            {[
              { icon: 'lucide:message-circle', text: 'Handle WhatsApp, Telegram, and Slack' },
              { icon: 'lucide:clock',          text: 'Cron scheduler: 24/7 tasks' },
              { icon: 'lucide:calendar',       text: 'Sync Google Calendar and Drive' },
              { icon: 'lucide:database',       text: 'Query and operate SQL databases' },
              { icon: 'lucide:webhook',        text: 'Incoming webhooks and REST API' },
              { icon: 'lucide:cloud',          text: 'Cloud storage (S3, Drive)' },
            ].map(item => (
              <li class="flex items-center gap-3 text-sm text-white/60">
                <div class="flex-shrink-0 w-7 h-7 rounded bg-white/[0.05] flex items-center justify-center">
                  <Icon name={item.icon} class="w-3.5 h-3.5 text-cyan-400" />
                </div>
                {item.text}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ── FEATURES ─────────────────────────────────────────────────────── -->
  <section
    id="features"
    class="py-12 md:py-20 relative overflow-hidden"
  >
    <!-- Subtle gradient background instead of noisy image -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-gillie-blue/[0.03] to-transparent pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gillie-blue/[0.04] rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-12 reveal">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-gillie-blue">Capabilities</p>
        <h2 class="section-title">Key Features</h2>
        <p class="section-subtitle">
          Discover everything Gillie AI can do for you
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="reveal reveal-delay-1">
          <FeatureCard
            icon="lucide:brain"
            title="AI Document Processing"
            description="Read, analyze, and extract data from PDFs, Word, Excel, and images with OCR. Also write and edit files directly."
            color="text-violet-400"
          />
        </div>
        <div class="reveal reveal-delay-2">
          <FeatureCard
            icon="lucide:search"
            title="RAG Over Your Data"
            description="Index your own documents and get accurate answers based on your knowledge. Vector search with FAISS and Qdrant."
            color="text-cyan-400"
          />
        </div>
        <div class="reveal reveal-delay-3">
          <FeatureCard
            icon="lucide:memory-stick"
            title="Persistent Memory"
            description="The assistant remembers information between sessions: preferences, previous solutions, and accumulated context of your work."
            color="text-teal-400"
          />
        </div>
        <div class="reveal reveal-delay-4">
          <FeatureCard
            icon="lucide:clock"
            title="Scheduled Tasks"
            description="Create and manage automated tasks with cron. The assistant runs workflows without manual intervention on the schedules you define."
            color="text-green-400"
          />
        </div>
        <div class="reveal reveal-delay-5">
          <FeatureCard
            icon="lucide:globe"
            title="Autonomous Web Navigation"
            description="Control the browser autonomously: navigate, click, extract content, and take screenshots of any website."
            color="text-orange-400"
          />
        </div>
        <div class="reveal reveal-delay-6">
          <FeatureCard
            icon="lucide:git-branch"
            title="Development Workflow"
            description="Read repos, run git status, diff, log, and commits. Execute shell commands and analyze your code directly from chat."
            color="text-rose-400"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────────────── -->
  <section id="how-it-works" class="py-12 md:py-20">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-12 reveal">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-gillie-blue">Process</p>
        <h2 class="section-title">How It Works</h2>
        <p class="section-subtitle">
          From zero to your assistant running in minutes
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
        <!-- Connecting line (desktop) -->
        <div class="hidden md:block absolute top-8 left-[calc(33%+2rem)] right-[calc(33%+2rem)] h-px bg-gradient-to-r from-blue-500/30 via-cyan-500/30 to-teal-500/30"></div>

        <!-- Step 1 -->
        <div class="group bg-white/[0.03] rounded-lg border border-white/10 p-7 hover:bg-white/[0.05] hover:-translate-y-1 hover:border-blue-500/30 transition-all duration-300 reveal reveal-delay-1">
          <div class="flex items-center gap-4 mb-5">
            <Icon name="lucide:package" class="w-7 h-7 text-blue-400 flex-shrink-0" />
            <div>
              <div class="text-xs font-bold text-blue-400 uppercase tracking-widest">Step 01</div>
              <h3 class="text-lg font-bold text-white">Installation</h3>
            </div>
          </div>
          <p class="text-white/60 text-sm leading-relaxed mb-5">
            Start the server with Docker in a single command. You can also install it locally with pip to use the CLI.
          </p>
          <!-- Quick start snippet -->
          <div class="bg-white/[0.05] rounded px-4 py-3 font-mono text-xs text-white/60 space-y-1">
            <div><span class="text-white/35"># Docker (server)</span></div>
            <div><span class="text-cyan-400">make</span> build <span class="text-white/35">&amp;&amp;</span> <span class="text-cyan-400">make</span> run</div>
            <div class="pt-1"><span class="text-white/35"># or local CLI</span></div>
            <div><span class="text-cyan-400">pip</span> install gillie-ai</div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="group bg-white/[0.03] rounded-lg border border-white/10 p-7 hover:bg-white/[0.05] hover:-translate-y-1 hover:border-cyan-500/30 transition-all duration-300 reveal reveal-delay-2">
          <div class="flex items-center gap-4 mb-5">
            <Icon name="lucide:settings-2" class="w-7 h-7 text-cyan-400 flex-shrink-0" />
            <div>
              <div class="text-xs font-bold text-cyan-400 uppercase tracking-widest">Step 02</div>
              <h3 class="text-lg font-bold text-white">Configuration</h3>
            </div>
          </div>
          <p class="text-white/60 text-sm leading-relaxed mb-5">
            Define your LLM provider and enable the integrations you need from the panel or the <code class="bg-white/10 px-1.5 py-0.5 rounded text-xs text-white/70">.env</code> file.
          </p>
          <ul class="space-y-2">
            {[
              { icon: 'lucide:key',           text: 'API key for OpenAI, Anthropic, DeepSeek, or local Ollama' },
              { icon: 'lucide:message-circle', text: 'Connect WhatsApp, Telegram, or Slack' },
              { icon: 'lucide:database',       text: 'Add SQL databases or RAG documents' },
              { icon: 'lucide:clock',          text: 'Configure automated cron tasks' },
            ].map(item => (
              <li class="flex items-center gap-2.5 text-sm text-white/60">
                <Icon name={item.icon} class="w-3.5 h-3.5 text-cyan-400 flex-shrink-0" />
                {item.text}
              </li>
            ))}
          </ul>
        </div>

        <!-- Step 3 -->
        <div class="group bg-white/[0.03] rounded-lg border border-white/10 p-7 hover:bg-white/[0.05] hover:-translate-y-1 hover:border-teal-500/30 transition-all duration-300 reveal reveal-delay-3">
          <div class="flex items-center gap-4 mb-5">
            <Icon name="lucide:play" class="w-7 h-7 text-teal-400 flex-shrink-0" />
            <div>
              <div class="text-xs font-bold text-teal-400 uppercase tracking-widest">Step 03</div>
              <h3 class="text-lg font-bold text-white">Get to Work</h3>
            </div>
          </div>
          <p class="text-white/60 text-sm leading-relaxed mb-5">
            Interact from your preferred channel. The assistant remembers context, executes tools, and learns from your workflow.
          </p>
          <div class="grid grid-cols-2 gap-2">
            {[
              { icon: 'lucide:terminal',       label: 'CLI' },
              { icon: 'lucide:globe',          label: 'Web UI' },
              { icon: 'lucide:message-circle', label: 'WhatsApp' },
              { icon: 'lucide:send',           label: 'Telegram' },
              { icon: 'lucide:hash',           label: 'Slack' },
              { icon: 'lucide:code-2',         label: 'REST API' },
            ].map(item => (
              <div class="flex items-center gap-2 bg-white/[0.05] rounded px-3 py-2 text-xs font-medium text-white/60">
                <Icon name={item.icon} class="w-3.5 h-3.5 text-teal-400" />
                {item.label}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── USE CASES ─────────────────────────────────────────────────────── -->
  <section id="use-cases" class="py-12 md:py-20">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-12 reveal">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-gillie-blue">Applications</p>
        <h2 class="section-title">Use Cases</h2>
        <p class="section-subtitle">
          Gillie AI adapts to different needs and sectors
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <UseCaseCard
          title="Education"
          description="Assistant for students and teachers, educational material processing, personalized tutoring."
          features={["Process academic PDFs", "Answer specific questions", "Generate summaries"]}
          color="blue"
        />
        <UseCaseCard
          title="Business"
          description="Process automation, commercial document analysis, intelligent customer service."
          features={["Process contracts", "Analyze reports", "WhatsApp integration"]}
          color="green"
        />
        <UseCaseCard
          title="Development"
          description="API for developers, integration with existing applications, workflow automation."
          features={["RESTful API", "Webhooks", "Available SDKs"]}
          color="purple"
        />
        <UseCaseCard
          title="Personal"
          description="Personal organization, intelligent reminders, personal document processing."
          features={["Task management", "Reminders", "OCR processing"]}
          color="orange"
        />
      </div>
    </div>
  </section>

  <!-- ── API SECTION ───────────────────────────────────────────────────── -->
  <section id="api" class="py-12 md:py-20 border-y border-white/[0.06]">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-12 reveal">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-cyan-400">Developers</p>
        <h2 class="section-title">Powerful API</h2>
        <p class="section-subtitle">
          Integrate Gillie AI into your applications with our complete and documented API
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Features list -->
        <div class="reveal reveal-delay-1 space-y-4">
          {[
            { icon: 'lucide:book-open',   label: 'OpenAPI / Swagger documentation' },
            { icon: 'lucide:shield',      label: 'Secure JWT authentication' },
            { icon: 'lucide:webhook',     label: 'Webhooks for real-time events' },
            { icon: 'lucide:layers',      label: 'SDKs for multiple languages' },
          ].map(item => (
            <div class="flex items-center gap-4 bg-white/[0.03] border border-white/10 rounded-lg px-5 py-4 hover:bg-white/[0.05] hover:border-cyan-500/30 transition-all duration-300">
              <Icon name={item.icon} class="w-5 h-5 text-cyan-400 flex-shrink-0" />
              <span class="text-white/80 font-medium">{item.label}</span>
            </div>
          ))}

          <div class="pt-2">
            <a href="#" class="btn-primary">
              <Icon name="lucide:external-link" class="w-4 h-4" />
              View API Documentation
            </a>
          </div>
        </div>

        <!-- Code block (terminal-window style) -->
        <div class="reveal reveal-delay-2 terminal-window">
          <div class="terminal-chrome">
            <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
            <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
            <span class="ml-auto text-white/35 text-xs font-mono">api.gillie.ai · example.js</span>
          </div>
          <pre class="text-sm text-white/60 p-6 overflow-x-auto leading-relaxed font-mono">{`// API usage example
const response = await fetch(
  'https://api.gillie.ai/v1/chat',
  {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer YOUR_API_KEY',
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      message: 'Process this PDF document',
      document_url: 'https://example.com/doc.pdf',
      context: 'education'
    })
  }
);

const { response: reply } = await response.json();
console.log(reply);`}</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TERMINAL DEMO ──────────────────────────────────────────────── -->
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="reveal terminal-window">
        <div class="terminal-chrome">
          <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
          <span class="ml-auto text-white/35 text-xs font-mono">~/workspace</span>
        </div>
        <div class="p-5 font-mono text-sm space-y-2">
          <div><span class="text-green-400">❯</span> <span class="text-white">gillie "analyze sales report and summarize key trends"</span></div>
          <div class="text-white/50 pl-2">Loading document... Processing with GPT-4o...</div>
          <div class="text-cyan-400 pl-2">✓ Found 3 key trends:</div>
          <div class="text-white/60 pl-4">1. Revenue up 23% YoY in Q4</div>
          <div class="text-white/60 pl-4">2. LATAM region fastest growing (+45%)</div>
          <div class="text-white/60 pl-4">3. SaaS subscriptions now 60% of total</div>
          <div class="mt-2"><span class="text-green-400">❯</span> <span class="text-white/40 animate-blink">_</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INTEGRATIONS ─────────────────────────────────────────────────── -->
  <section id="integrations" class="py-12 md:py-20 bg-gradient-to-b from-transparent via-white/[0.02] to-transparent">
    <div class="container mx-auto px-6 max-w-6xl">

      <div class="text-center mb-12 reveal">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-gillie-blue">Integrations</p>
        <h2 class="section-title">Connect with your entire stack</h2>
        <p class="section-subtitle">
          Gillie AI natively connects with the platforms you already use. No extra code.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {[
          { icon: 'lucide:bot',           name: 'OpenAI',           desc: 'GPT-4o and advanced models',       color: 'bg-green-500/10 text-green-400', border: 'hover:border-green-500/30' },
          { icon: 'lucide:cpu',           name: 'Anthropic',        desc: 'Claude Sonnet / Opus',             color: 'bg-orange-500/10 text-orange-400', border: 'hover:border-orange-500/30' },
          { icon: 'lucide:zap',           name: 'DeepSeek',         desc: 'Fast open source models',          color: 'bg-blue-500/10 text-blue-400', border: 'hover:border-blue-500/30' },
          { icon: 'lucide:share-2',       name: 'OpenRouter',       desc: 'Access to 100+ LLM models',        color: 'bg-purple-500/10 text-purple-400', border: 'hover:border-purple-500/30' },
          { icon: 'lucide:brain',         name: 'Ollama',           desc: 'Local models: Llama, Mistral…',   color: 'bg-indigo-500/10 text-indigo-400', border: 'hover:border-indigo-500/30' },
          { icon: 'lucide:message-circle',name: 'WhatsApp',         desc: 'Meta Business API + Neonize Web',  color: 'bg-emerald-500/10 text-emerald-400', border: 'hover:border-emerald-500/30' },
          { icon: 'lucide:send',          name: 'Telegram',         desc: 'Bot API with webhook',             color: 'bg-sky-500/10 text-sky-400', border: 'hover:border-sky-500/30' },
          { icon: 'lucide:hash',          name: 'Slack',            desc: 'Bot and slash commands',           color: 'bg-rose-500/10 text-rose-400', border: 'hover:border-rose-500/30' },
          { icon: 'lucide:calendar',      name: 'Google Calendar',  desc: 'Events and reminders OAuth',       color: 'bg-blue-500/10 text-blue-400', border: 'hover:border-blue-500/30' },
          { icon: 'lucide:hard-drive',    name: 'Google Drive',     desc: 'Read and upload files OAuth',      color: 'bg-yellow-500/10 text-yellow-400', border: 'hover:border-yellow-500/30' },
