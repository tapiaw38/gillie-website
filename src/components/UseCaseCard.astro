---
import { Icon } from 'astro-icon/components';

export interface Props {
  title: string;
  description: string;
  features: string[];
  color: 'blue' | 'green' | 'purple' | 'orange';
  icon?: string;
}

const { title, description, features, color = 'blue', icon } = Astro.props;

const config = {
  blue:   { accent: 'text-blue-400',   icon: icon ?? 'lucide:graduation-cap' },
  green:  { accent: 'text-emerald-400', icon: icon ?? 'lucide:briefcase' },
  purple: { accent: 'text-violet-400',  icon: icon ?? 'lucide:code-2' },
  orange: { accent: 'text-orange-400',  icon: icon ?? 'lucide:user' },
};

const c = config[color];
---

<div class="group relative bg-white/[0.03] rounded-lg border border-white/10 p-7 hover:bg-white/[0.05] hover:-translate-y-1 hover:border-white/20 transition-all duration-300 overflow-hidden">
  <!-- Subtle glow on hover -->
  <div class={`absolute inset-0 bg-gradient-to-br from-${color === 'blue' ? 'blue' : color === 'green' ? 'emerald' : color === 'purple' ? 'violet' : 'orange'}-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>

  <!-- Icon (no background) -->
  <div class="mb-5">
    <Icon name={c.icon} class={`w-7 h-7 ${c.accent}`} />
  </div>

  <h3 class="text-lg font-bold text-white mb-2">{title}</h3>
  <p class="text-white/60 text-sm leading-relaxed mb-5">{description}</p>

  <!-- Feature list -->
  <ul class="space-y-2">
    {features.map((feature) => (
      <li class="flex items-center gap-2.5 text-sm text-white/60">
        <Icon name="lucide:check" class={`w-4 h-4 flex-shrink-0 ${c.accent}`} />
        {feature}
      </li>
    ))}
  </ul>
</div>
