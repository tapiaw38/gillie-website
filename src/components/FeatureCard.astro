---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon: string;
  title: string;
  description: string;
  color?: string;
}

const { icon: iconName, title, description, color = 'text-blue-400' } = Astro.props;
---

<div class="feature-card group relative bg-white/[0.03] rounded-lg p-7 border border-white/10 hover:bg-white/[0.05] hover:-translate-y-1 hover:border-white/20 transition-all duration-300 overflow-hidden">
  <!-- Icon (no background) -->
  <div class="mb-5">
    <Icon name={iconName} class={`w-7 h-7 ${color}`} />
  </div>

  <h3 class="text-lg font-bold text-white mb-2">{title}</h3>
  <p class="text-white/60 text-sm leading-relaxed">{description}</p>
</div>
