---
import { Icon } from 'astro-icon/components';

const navLinks = [
  { href: '#features',     icon: 'lucide:layers',      label: 'Features' },
  { href: '#how-it-works', icon: 'lucide:map',          label: 'How It Works'  },
  { href: '#use-cases',    icon: 'lucide:briefcase',    label: 'Use Cases'   },
  { href: '#api',          icon: 'lucide:code-2',       label: 'API'            },
  { href: '#integrations', icon: 'lucide:plug',         label: 'Integrations'  },
  { href: '#pricing',      icon: 'lucide:credit-card',  label: 'Pricing'        },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="bg-black/80 backdrop-blur-xl border-b border-white/[0.08]">
    <nav class="container mx-auto px-6 py-4">
      <div class="flex items-center justify-between">

        <!-- Logo -->
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 group">
          <img
            src={`${import.meta.env.BASE_URL}assets/gillie-logo.png`}
            alt="Gillie AI"
            class="h-10 w-10 md:h-8 md:w-8 object-contain group-hover:scale-105 transition-transform duration-200"
          />
          <span class="text-lg font-bold text-white">Gillie <span class="text-gillie-blue">AI</span></span>
        </a>

        <!-- Desktop nav — text links -->
        <div class="hidden md:flex items-center gap-6">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              class="text-sm text-white/60 hover:text-white transition-colors duration-200"
            >
              {label}
            </a>
          ))}

          <!-- CTA button -->
          <a href="#contact" class="btn-primary text-sm py-2.5 px-5 ml-2">
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
            Get Started
          </a>
        </div>

        <!-- Mobile menu button -->
        <button
          class="md:hidden p-2 rounded hover:bg-white/[0.05] transition-colors"
          id="menu-button"
          aria-label="Menú"
        >
          <Icon name="lucide:menu" class="w-5 h-5 text-white/70" id="menu-icon-open" />
          <Icon name="lucide:x" class="w-5 h-5 text-white/70 hidden" id="menu-icon-close" />
        </button>
      </div>

      <!-- Mobile nav — icon + label -->
      <div class="md:hidden hidden mt-4 pb-2 border-t border-white/10 pt-4 space-y-1" id="mobile-menu">
        {navLinks.map(({ href, icon, label }) => (
          <a
            href={href}
            class="flex items-center gap-2.5 text-white/70 hover:text-white font-medium py-2 px-3 rounded hover:bg-white/[0.05] transition-colors text-sm"
          >
            <Icon name={icon} class="w-4 h-4" />
            {label}
          </a>
        ))}
        <div class="pt-2">
          <a href="#contact" class="btn-primary w-full justify-center">
            <Icon name="lucide:rocket" class="w-4 h-4" />
            Get Started
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
  });

  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });
</script>
