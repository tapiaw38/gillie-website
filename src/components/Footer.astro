---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white">
  <div class="container mx-auto px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Logo and description -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center space-x-3 mb-4">
          <img src={`${import.meta.env.BASE_URL}assets/gillie-logo.png`} alt="Gillie AI Logo" class="h-14 w-14 object-contain invert" />
          <span class="text-2xl font-bold text-white">Gillie AI</span>
        </div>
        <p class="text-gray-400">
          Tu asistente inteligente para tareas diarias, procesamiento de documentos y automatización.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Enlaces Rápidos</h3>
        <ul class="space-y-2">
          <li><a href="#features" class="text-gray-400 hover:text-white transition-colors">Características</a></li>
          <li><a href="#how-it-works" class="text-gray-400 hover:text-white transition-colors">Cómo Funciona</a></li>
          <li><a href="#use-cases" class="text-gray-400 hover:text-white transition-colors">Casos de Uso</a></li>
          <li><a href="#api" class="text-gray-400 hover:text-white transition-colors">Documentación API</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Recursos</h3>
        <ul class="space-y-2">
          <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Documentación</a></li>
          <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Tutoriales</a></li>
          <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Blog</a></li>
          <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Soporte</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Contacto</h3>
        <ul class="space-y-2">
          <li class="text-gray-400">support@gillie.ai</li>
          <li class="text-gray-400">+54 9 11 1234-5678</li>
          <li class="text-gray-400">Argentina</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400">
      <p>&copy; {currentYear} Gillie AI. Todos los derechos reservados.</p>
      <p class="mt-2 text-sm">Desarrollado con ❤️ por Walter Tapia</p>
    </div>
  </div>
</footer>