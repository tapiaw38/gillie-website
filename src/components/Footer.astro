---
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: '#', icon: 'lucide:twitter', label: 'Twitter' },
  { href: '#', icon: 'lucide:github', label: 'GitHub' },
  { href: '#', icon: 'lucide:linkedin', label: 'LinkedIn' },
];
---

<footer class="relative bg-black border-t border-white/10 text-white">
  <!-- Gradient divider -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gillie-blue/40 to-transparent"></div>
  <div class="container mx-auto px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Logo and description -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center space-x-3 mb-4">
          <img src={`${import.meta.env.BASE_URL}assets/gillie-logo.png`} alt="Gillie AI Logo" class="h-8 w-8 object-contain" />
          <span class="text-2xl font-bold text-white">Gillie AI</span>
        </div>
        <p class="text-white/40 mb-4">
          Your intelligent assistant for daily tasks, document processing, and automation.
        </p>
        <!-- Social links -->
        <div class="flex gap-3">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              aria-label={link.label}
              class="flex items-center justify-center w-9 h-9 rounded-lg bg-white/[0.05] border border-white/10 hover:border-gillie-blue/50 hover:bg-white/[0.08] transition-all duration-200"
            >
              <Icon name={link.icon} class="w-4 h-4 text-white/60 hover:text-white" />
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="#features" class="text-white/40 hover:text-white transition-colors">Features</a></li>
          <li><a href="#how-it-works" class="text-white/40 hover:text-white transition-colors">How It Works</a></li>
          <li><a href="#use-cases" class="text-white/40 hover:text-white transition-colors">Use Cases</a></li>
          <li><a href="#api" class="text-white/40 hover:text-white transition-colors">API Documentation</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Resources</h3>
        <ul class="space-y-2">
          <li><a href="#" class="text-white/40 hover:text-white transition-colors">Documentation</a></li>
          <li><a href="#" class="text-white/40 hover:text-white transition-colors">Tutorials</a></li>
          <li><a href="#" class="text-white/40 hover:text-white transition-colors">Blog</a></li>
          <li><a href="#" class="text-white/40 hover:text-white transition-colors">Support</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Contact</h3>
        <ul class="space-y-2">
          <li class="text-white/40">support@gillie.ai</li>
          <li class="text-white/40">+54 9 11 1234-5678</li>
          <li class="text-white/40">Argentina</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-8 pt-8 text-center text-white/40">
      <p>&copy; {currentYear} Gillie AI. All rights reserved.</p>
    </div>
  </div>
</footer>